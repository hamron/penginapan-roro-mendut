---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { site, linkWhatsApp } from '../../config';
import { daftarKamar, formatRupiah } from '../../data/kamar';

export function getStaticPaths() {
  return daftarKamar.map((kamar, index) => ({
    params: { id: kamar.id },
    props: {
      kamar,
      sebelumnya: daftarKamar[index - 1] ?? daftarKamar[daftarKamar.length - 1],
      berikutnya: daftarKamar[index + 1] ?? daftarKamar[0],
    },
  }));
}

const { kamar, sebelumnya, berikutnya } = Astro.props;

const waPesan = linkWhatsApp(`Halo ${site.namaPendek}, saya ingin memesan ${kamar.nama}.`);
const spesifikasi = [
  { label: 'Kapasitas', nilai: `${kamar.kapasitas} tamu` },
  { label: 'Ukuran kamar', nilai: kamar.ukuran },
  { label: 'Tipe kasur', nilai: kamar.tipeKasur },
].filter((s) => s.nilai);
---

<Layout
  judul={`${kamar.nama} — Penginapan murah dekat Borobudur`}
  deskripsi={`${kamar.deskripsi} Penginapan Roro Mendut, Mendut, Magelang.`}
  gambar={kamar.gambar}
>
  <Header slot="header" />

  {/* ============ BREADCRUMB ============ */}
  <nav aria-label="Breadcrumb" class="border-b border-ink-200 bg-ink-50">
    <div class="mx-auto flex max-w-6xl items-center gap-2 px-4 py-3 text-xs font-semibold tracking-wide text-ink-600 uppercase sm:px-6">
      <a href="/" class="hover:text-brand-600">Beranda</a>
      <span aria-hidden="true">/</span>
      <a href="/#kamar" class="hover:text-brand-600">Kamar</a>
      <span aria-hidden="true">/</span>
      <span class="text-ink-900">{kamar.nama}</span>
    </div>
  </nav>

  {/* ============ DETAIL ============ */}
  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6 sm:py-16">
    <img
      src={kamar.gambar}
      alt={kamar.nama}
      width="1200"
      height="675"
      class="aspect-video w-full rounded-xl border border-ink-200 bg-brand-100 object-cover shadow-lg"
    />

    <p class="mt-10 text-xs font-bold tracking-[0.2em] text-brand-600 uppercase">{site.namaPendek}</p>
    <h1 class="mt-2 font-display text-3xl font-bold text-ink-900 sm:text-4xl">{kamar.nama}</h1>

    <p class="mt-6 max-w-2xl text-base leading-relaxed text-ink-600">{kamar.deskripsi}</p>

    <dl class="mt-8 grid grid-cols-1 gap-6 border-y border-ink-200 py-8 sm:grid-cols-3">
      {spesifikasi.map((s) => (
        <div>
          <dt class="text-xs font-bold tracking-widest text-ink-600 uppercase">{s.label}</dt>
          <dd class="mt-1 text-lg font-semibold text-ink-900">{s.nilai}</dd>
        </div>
      ))}
    </dl>

    <div class="mt-10">
      <h2 class="font-display text-lg font-bold tracking-wide text-ink-900 uppercase">Fasilitas Kamar</h2>
      <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-3 sm:grid-cols-3">
        {kamar.fasilitas.map((f) => (
          <li class="flex items-center gap-2 text-sm text-ink-700">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-brand-600" aria-hidden="true">
              <path d="M20 6 9 17l-5-5" />
            </svg>
            {f}
          </li>
        ))}
      </ul>
    </div>

    {!kamar.tersedia && (
      <p class="mt-8 bg-ink-100 px-4 py-3 text-sm font-semibold text-ink-800">
        Kamar ini sedang penuh. Hubungi kami untuk cek jadwal ketersediaan berikutnya.
      </p>
    )}

    <div class="mt-10 flex flex-wrap items-center gap-6 border-t border-ink-200 pt-8">
      <p class="text-2xl font-bold text-ink-900">
        <span class="text-base font-semibold text-ink-600">Mulai</span> {formatRupiah(kamar.hargaPerMalam)}<span class="text-sm font-normal text-ink-600">/malam</span>
      </p>
      <a
        href={waPesan}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-sm bg-brand-600 px-8 py-3.5 text-xs font-bold tracking-widest text-ink-900 uppercase transition-colors hover:bg-brand-500"
      >
        Pesan via WhatsApp
      </a>
    </div>
  </section>

  {/* ============ NAVIGASI KAMAR LAIN ============ */}
  <section class="border-t border-ink-200 bg-ink-50">
    <div class="mx-auto flex max-w-6xl items-stretch justify-between px-4 py-6 text-sm sm:px-6">
      <a href={`/kamar/${sebelumnya.id}`} class="group flex items-center gap-2 text-ink-600 hover:text-brand-600">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
        <span>
          <span class="block text-xs tracking-wide uppercase">Sebelumnya</span>
          <span class="font-semibold text-ink-900 group-hover:text-brand-600">{sebelumnya.nama}</span>
        </span>
      </a>
      <a href={`/kamar/${berikutnya.id}`} class="group flex items-center gap-2 text-right text-ink-600 hover:text-brand-600">
        <span>
          <span class="block text-xs tracking-wide uppercase">Berikutnya</span>
          <span class="font-semibold text-ink-900 group-hover:text-brand-600">{berikutnya.nama}</span>
        </span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
