---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormPemesanan from '../components/FormPemesanan.astro';
import { site, linkWhatsApp, linkPetaEmbed, linkGoogleMaps } from '../config';
import { daftarKamar, formatRupiah } from '../data/kamar';
import { daftarFasilitas } from '../data/fasilitas';
import { daftarWisata } from '../data/wisata';

const hargaTerendah = Math.min(...daftarKamar.map((k) => k.hargaPerMalam));
const waUmum = linkWhatsApp(`Halo ${site.namaPendek}, saya ingin bertanya soal ketersediaan kamar.`);
const nomorTelepon = site.telepon.replace(/[^\d+]/g, '');
---

<Layout>
  <Header slot="header" />

  {/* ============ HERO ============ */}
  <section class="bg-ink-50">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-14 sm:px-6 md:py-20 lg:grid-cols-2">
      <div>
        <p class="text-xs font-bold tracking-[0.2em] text-brand-600 uppercase">
          {site.alamat.kota}
        </p>
        <h1 class="mt-3 font-display text-3xl leading-tight font-bold tracking-tight text-ink-900 uppercase sm:text-4xl">
          {site.tagline}
        </h1>
        <p class="mt-5 max-w-lg text-base leading-relaxed text-ink-600">
          {site.deskripsi}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={waUmum}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-sm bg-brand-600 px-6 py-3 text-xs font-bold tracking-widest text-ink-900 uppercase transition-colors hover:bg-brand-500"
          >
            Pesan via WhatsApp
          </a>
          <a
            href="#kamar"
            class="rounded-sm border border-ink-800 px-6 py-3 text-xs font-bold tracking-widest text-ink-800 uppercase transition-colors hover:border-brand-600 hover:text-brand-600"
          >
            Lihat kamar
          </a>
        </div>

        <p class="mt-6 text-sm text-ink-600">
          Mulai <span class="font-bold text-ink-900">{formatRupiah(hargaTerendah)}</span> per malam
          &middot; Pesan langsung, tanpa biaya tambahan
        </p>
      </div>

      <img
        src="/hero.jpg"
        alt={`Kamar di ${site.namaPendek}`}
        width="1600"
        height="900"
        class="aspect-4/3 w-full rounded-2xl border border-ink-200 bg-brand-100 object-cover shadow-xl"
      />
    </div>
  </section>

  {/* ============ FASILITAS ============ */}
  <section id="fasilitas" class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="text-center">
      <p class="relative mx-auto inline-block px-14 text-sm font-bold tracking-wide text-brand-600 uppercase">
        <span class="absolute top-1/2 left-0 h-0.5 w-11 -translate-y-1/2 bg-brand-600" aria-hidden="true"></span>
        Kenyamanan
        <span class="absolute top-1/2 right-0 h-0.5 w-11 -translate-y-1/2 bg-brand-600" aria-hidden="true"></span>
      </p>
      <h2 class="mt-2 font-display text-3xl font-bold text-ink-900">
        Fasilitas <span class="text-brand-600 uppercase">Kami</span>
      </h2>
    </div>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {daftarFasilitas.map((f) => (
        <li class="flex gap-4 rounded-xl border border-ink-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md">
          <span class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={f.ikon} />
            </svg>
          </span>
          <div>
            <p class="text-sm font-bold tracking-wide text-ink-900 uppercase">{f.nama}</p>
            <p class="mt-1 text-sm text-ink-600">{f.ket}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  {/* ============ KAMAR ============ */}
  <section id="kamar" class="border-y border-ink-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <div class="text-center">
        <p class="relative mx-auto inline-block px-14 text-sm font-bold tracking-wide text-brand-600 uppercase">
          <span class="absolute top-1/2 left-0 h-0.5 w-11 -translate-y-1/2 bg-brand-600" aria-hidden="true"></span>
          Menginap
          <span class="absolute top-1/2 right-0 h-0.5 w-11 -translate-y-1/2 bg-brand-600" aria-hidden="true"></span>
        </p>
        <h2 class="mt-2 font-display text-3xl font-bold text-ink-900">
          Pilihan <span class="text-brand-600 uppercase">Kamar</span>
        </h2>
      </div>

      <div class="relative mt-10">
        <button
          type="button"
          data-carousel-prev
          aria-label="Kamar sebelumnya"
          class="absolute top-[28.5%] -left-10 z-10 hidden size-10 items-center justify-center rounded-full border border-ink-200 bg-white text-ink-800 shadow-md transition-colors hover:border-brand-300 hover:text-brand-600 lg:flex"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
        </button>

        <ul data-carousel-track class="no-scrollbar flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth pb-2">
          {daftarKamar.map((kamar) => (
            <li class="w-[85%] shrink-0 snap-start sm:w-[46%] lg:w-[calc((100%-3rem)/3)]">
              <div class="overflow-hidden rounded-xl border border-ink-200 bg-white shadow-md transition-shadow duration-300 hover:shadow-lg">
                <a href={`/kamar/${kamar.id}`} class="group block">
                  <div class="relative overflow-hidden border-b border-ink-200">
                    <img
                      src={kamar.gambar}
                      alt={kamar.nama}
                      width="1200"
                      height="800"
                      class="aspect-4/3 w-full bg-brand-100 object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                    <span class="absolute top-3 left-3 rounded-sm bg-brand-600 px-3 py-1.5 text-xs font-bold text-ink-900 sm:text-sm">
                      Mulai {formatRupiah(kamar.hargaPerMalam)}/malam
                    </span>
                    {!kamar.tersedia && (
                      <span class="absolute top-3 right-3 bg-ink-900/80 px-2.5 py-1 text-xs font-bold tracking-wide text-white uppercase">
                        Penuh
                      </span>
                    )}
                  </div>
                </a>

                <div class="relative p-5 shadow-[inset_0_6px_8px_-8px_rgba(0,0,0,0.3)]">
                  <a href={`/kamar/${kamar.id}`} class="hover:text-brand-600">
                    <h3 class="font-display text-xl font-bold text-ink-900">{kamar.nama}</h3>
                  </a>

                  <ul class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-ink-600">
                    <li class="flex items-center gap-1.5">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-600" aria-hidden="true"><path d="M17 10H3a1 1 0 0 0-1 1v6h1v-3h18v3h1v-6a1 1 0 0 0-1-1zM4 8V6a2 2 0 0 1 2-2h1a2 2 0 0 1 2 2v2M15 8V6a2 2 0 0 1 2-2h1a2 2 0 0 1 2 2v2" /></svg>
                      {kamar.tipeKasur}
                    </li>
                    <li class="flex items-center gap-1.5">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-600" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM19 8v6M22 11h-6" /></svg>
                      {kamar.kapasitas} Tamu
                    </li>
                    {kamar.ukuran && (
                      <li class="flex items-center gap-1.5">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-600" aria-hidden="true"><path d="M3 15a4 4 0 0 1 8 0M12 15a4 4 0 0 1 8 0M3 15v3a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-3M7 15v-2a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2" /></svg>
                        {kamar.ukuran}
                      </li>
                    )}
                  </ul>

                  <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-ink-600">{kamar.deskripsi}</p>

                  <div class="mt-4 grid grid-cols-2 gap-2">
                    <a
                      href={`/kamar/${kamar.id}`}
                      class="rounded-sm bg-brand-600 px-4 py-2.5 text-center text-xs leading-tight font-bold tracking-widest text-ink-900 uppercase transition-colors hover:bg-brand-500"
                    >
                      Lihat<br />Detail
                    </a>
                    <a
                      href={linkWhatsApp(`Halo ${site.namaPendek}, saya ingin memesan ${kamar.nama}.`)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="rounded-sm bg-ink-900 px-4 py-2.5 text-center text-xs leading-tight font-bold tracking-widest text-white uppercase transition-colors hover:bg-ink-800"
                    >
                      Pesan<br />Sekarang
                    </a>
                  </div>
                </div>
              </div>
            </li>
          ))}
        </ul>

        <button
          type="button"
          data-carousel-next
          aria-label="Kamar berikutnya"
          class="absolute top-[28.5%] -right-10 z-10 hidden size-10 items-center justify-center rounded-full border border-ink-200 bg-white text-ink-800 shadow-md transition-colors hover:border-brand-300 hover:text-brand-600 lg:flex"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </button>
      </div>
    </div>
  </section>

  <script>
    const track = document.querySelector('[data-carousel-track]');
    const prev = document.querySelector('[data-carousel-prev]');
    const next = document.querySelector('[data-carousel-next]');

    function scrollByCard(dir: number) {
      const card = track?.querySelector('li');
      if (!track || !card) return;
      const gap = 24; // gap-6
      const amount = (card.getBoundingClientRect().width + gap) * dir;
      track.scrollBy({ left: amount, behavior: 'smooth' });
    }

    prev?.addEventListener('click', () => scrollByCard(-1));
    next?.addEventListener('click', () => scrollByCard(1));
  </script>

  {/* ============ LOKASI ============ */}
  <section id="lokasi" class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="text-center">
      <p class="relative mx-auto inline-block px-14 text-sm font-bold tracking-wide text-brand-600 uppercase">
        <span class="absolute top-1/2 left-0 h-0.5 w-11 -translate-y-1/2 bg-brand-600" aria-hidden="true"></span>
        Temukan Kami
        <span class="absolute top-1/2 right-0 h-0.5 w-11 -translate-y-1/2 bg-brand-600" aria-hidden="true"></span>
      </p>
      <h2 class="mt-2 font-display text-3xl font-bold text-ink-900">
        Lokasi <span class="text-brand-600 uppercase">Kami</span>
      </h2>
    </div>

    <div class="mt-8 overflow-hidden rounded-xl border border-ink-200 bg-white shadow-md">
      <iframe
        src={linkPetaEmbed()}
        title={`Peta lokasi ${site.nama}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="h-96 w-full border-0"
      />
    </div>

    <a
      href={linkGoogleMaps()}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-brand-600 hover:underline"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0Z" /><circle cx="12" cy="10" r="3" />
      </svg>
      Buka di Google Maps
    </a>
  </section>

  {/* ============ WISATA SEKITAR (cuplikan) ============ */}
  <section id="wisata" class="border-y border-ink-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <div class="text-center">
        <p class="relative mx-auto inline-block px-14 text-sm font-bold tracking-wide text-brand-600 uppercase">
          <span class="absolute top-1/2 left-0 h-0.5 w-11 -translate-y-1/2 bg-brand-600" aria-hidden="true"></span>
          Jelajahi
          <span class="absolute top-1/2 right-0 h-0.5 w-11 -translate-y-1/2 bg-brand-600" aria-hidden="true"></span>
        </p>
        <h2 class="mt-2 font-display text-3xl font-bold text-ink-900">
          Wisata <span class="text-brand-600 uppercase">Sekitar</span>
        </h2>
        <p class="mt-2 text-ink-600">Kawasan Mendut &amp; Borobudur, semua bisa dijangkau dalam sekali jalan.</p>
      </div>

      <ul class="mt-10 grid gap-6 sm:grid-cols-3">
        {daftarWisata.slice(0, 3).map((w) => (
          <li class="flex flex-col rounded-xl border border-ink-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md">
            <p class="font-display text-lg font-bold text-ink-900">{w.nama}</p>
            <p class="mt-1 text-xs font-semibold tracking-wide text-brand-600 uppercase">{w.jarak}</p>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600">{w.deskripsi}</p>
          </li>
        ))}
      </ul>

      <div class="mt-10 text-center">
        <a
          href="/wisata-terdekat"
          class="inline-flex items-center gap-2 rounded-sm bg-brand-600 px-6 py-3 text-xs font-bold tracking-widest text-ink-900 uppercase transition-colors hover:bg-brand-500"
        >
          Lihat Semua Wisata Terdekat
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </section>

  {/* ============ ULASAN ============ */}
  <section id="ulasan" class="border-y border-ink-200 bg-white">
    <div class="mx-auto max-w-3xl px-4 py-14 text-center sm:px-6">
      <p class="text-xs font-bold tracking-[0.2em] text-brand-600 uppercase">Kata Tamu</p>
      <h2 class="mt-2 font-display text-2xl font-bold tracking-wide text-ink-900 uppercase">Sudah menginap di sini?</h2>
      <p class="mt-3 text-ink-600">
        Ulasanmu sangat membantu tamu lain menemukan tempat ini. Cukup satu menit.
      </p>
      <a
        href={site.linkReviewGoogle}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-7 inline-flex items-center gap-2 rounded-sm bg-brand-600 px-6 py-3 text-xs font-bold tracking-widest text-ink-900 uppercase transition-colors hover:bg-brand-500"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1L12 2z" />
        </svg>
        Beri ulasan di Google
      </a>
    </div>
  </section>

  <FormPemesanan />

  {/* ============ KONTAK ============ */}
  <section id="kontak" class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <p class="text-xs font-bold tracking-[0.2em] text-brand-600 uppercase">Hubungi Kami</p>
    <h2 class="mt-2 font-display text-2xl font-bold tracking-wide text-ink-900 uppercase">Kontak</h2>
    <p class="mt-2 text-ink-600">Balasan tercepat lewat WhatsApp.</p>

    <div class="mt-10 grid gap-4 sm:grid-cols-3">
      <a
        href={waUmum}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-xl border border-ink-200 bg-white p-6 shadow-sm transition-shadow hover:border-brand-300 hover:shadow-md"
      >
        <p class="text-xs font-bold tracking-widest text-ink-900 uppercase">WhatsApp</p>
        <p class="mt-1 text-sm text-ink-600">{site.telepon}</p>
      </a>

      <a
        href={`tel:${nomorTelepon}`}
        class="rounded-xl border border-ink-200 bg-white p-6 shadow-sm transition-shadow hover:border-brand-300 hover:shadow-md"
      >
        <p class="text-xs font-bold tracking-widest text-ink-900 uppercase">Telepon</p>
        <p class="mt-1 text-sm text-ink-600">{site.telepon}</p>
      </a>

      <a
        href={`mailto:${site.email}`}
        class="rounded-xl border border-ink-200 bg-white p-6 shadow-sm transition-shadow hover:border-brand-300 hover:shadow-md"
      >
        <p class="text-xs font-bold tracking-widest text-ink-900 uppercase">Email</p>
        <p class="mt-1 text-sm break-all text-ink-600">{site.email}</p>
      </a>
    </div>
  </section>

  {/* Tombol WhatsApp mengambang, selalu terlihat termasuk di layar kecil */}
  <a
    href={waUmum}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat WhatsApp"
    class="fixed right-5 bottom-5 z-40 flex size-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition-transform hover:scale-105"
  >
    <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3.1.8.8-3-.2-.3a8.2 8.2 0 1 1 7.2 3.9z" />
      <path d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.7 1-.9 1.2-.2.2-.3.2-.6.1-1.7-.9-2.9-1.6-4-3.5-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.5s-.7-1.6-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5 1.9.8 2.6.9 3.5.8.6-.1 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.4z" />
    </svg>
  </a>

  <Footer slot="footer" />
</Layout>
