---
import { site, alamatLengkap } from '../config';

const tahun = new Date().getFullYear();
const sosial = Object.entries(site.sosial).filter(([, url]) => url !== '');
---

<footer class="mt-10 bg-ink-900">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-3">
    <div>
      <p class="font-display text-lg font-bold tracking-wide text-white uppercase">{site.namaPendek}</p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-ink-100">{site.tagline}</p>

      {sosial.length > 0 && (
        <ul class="mt-5 flex gap-4 text-xs font-semibold tracking-wider text-brand-500 uppercase">
          {sosial.map(([nama, url]) => (
            <li>
              <a href={url} target="_blank" rel="noopener noreferrer" class="hover:underline">
                {nama}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div>
      <p class="text-xs font-bold tracking-widest text-white uppercase">Kontak</p>
      <ul class="mt-3 space-y-2 text-sm text-ink-100">
        <li><a href={`tel:${site.telepon.replace(/[^\d+]/g, '')}`} class="hover:text-brand-500">{site.telepon}</a></li>
        <li><a href={`mailto:${site.email}`} class="hover:text-brand-500">{site.email}</a></li>
        <li class="pt-1 leading-relaxed">{alamatLengkap}</li>
      </ul>
    </div>

    <div>
      <p class="text-xs font-bold tracking-widest text-white uppercase">Jam</p>
      <ul class="mt-3 space-y-2 text-sm text-ink-100">
        <li>Check-in mulai {site.jamOperasional.checkIn}</li>
        <li>Check-out sebelum {site.jamOperasional.checkOut}</li>
        <li>Resepsionis {site.jamOperasional.resepsionis}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10 px-4 py-5 text-center text-xs tracking-wide text-ink-400 sm:px-6">
    &copy; {tahun} {site.namaPendek}. Seluruh hak cipta dilindungi.
  </div>
</footer>
