---
import { site, alamatLengkap } from '../config';

const tahun = new Date().getFullYear();
const sosial = Object.entries(site.sosial).filter(([, url]) => url !== '');
---

<footer class="mt-24 border-t border-ink-200 bg-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-3">
    <div>
      <p class="font-display text-lg font-semibold text-ink-900">{site.nama}</p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-ink-600">{site.tagline}</p>

      {sosial.length > 0 && (
        <ul class="mt-5 flex gap-4 text-sm font-medium text-brand-600">
          {sosial.map(([nama, url]) => (
            <li>
              <a href={url} target="_blank" rel="noopener noreferrer" class="capitalize hover:underline">
                {nama}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div>
      <p class="text-sm font-semibold text-ink-900">Kontak</p>
      <ul class="mt-3 space-y-2 text-sm text-ink-600">
        <li><a href={`tel:${site.telepon.replace(/[^\d+]/g, '')}`} class="hover:text-brand-600">{site.telepon}</a></li>
        <li><a href={`mailto:${site.email}`} class="hover:text-brand-600">{site.email}</a></li>
        <li class="pt-1 leading-relaxed">{alamatLengkap}</li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-ink-900">Jam</p>
      <ul class="mt-3 space-y-2 text-sm text-ink-600">
        <li>Check-in mulai {site.jamOperasional.checkIn}</li>
        <li>Check-out sebelum {site.jamOperasional.checkOut}</li>
        <li>Resepsionis {site.jamOperasional.resepsionis}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-ink-200 px-4 py-5 text-center text-xs text-ink-400 sm:px-6">
    &copy; {tahun} {site.nama}. Seluruh hak cipta dilindungi.
  </div>
</footer>
